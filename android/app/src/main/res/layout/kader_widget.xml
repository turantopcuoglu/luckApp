<?xml version="1.0" encoding="utf-8"?>
<!-- Ana ekran widget'ı düzeni: lacivert zemin, üstte marka + yonca,
     ortada altın büyük skor, altta tarih ve kısa ipucu. Metinler
     KaderWidgetProvider tarafından SharedPreferences'tan doldurulur. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/kader_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/kader_widget_bg"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Kader"
            android:textColor="@color/kader_gold"
            android:textSize="13sp"
            android:letterSpacing="0.1"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/kader_widget_skor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="--"
        android:textColor="@color/kader_gold"
        android:textSize="40sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/kader_widget_tarih"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="@color/kader_text_secondary"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/kader_widget_teaser"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text=""
        android:textColor="@color/kader_text_secondary"
        android:textSize="12sp"
        android:maxLines="2"
        android:ellipsize="end" />
</LinearLayout>
